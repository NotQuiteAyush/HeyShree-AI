{
  "name": "shree-desktop-ai",
  "private": true,
  "version": "1.1.52",
  "type": "module",
  "description": "Shree Mark 12 secure Windows desktop AI assistant",
  "author": "Ayush",
  "license": "UNLICENSED",
  "copyright": "Copyright © 2026 Ayush",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:backend": "uv run --project backend uvicorn shree.main:app --host 0.0.0.0 --port 8765 --reload",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:8765/api/health && cross-env SHREE_DEV_URL=http://127.0.0.1:5173 SHREE_BACKEND_URL=http://127.0.0.1:8765 electron .",
    "build": "vite build",
    "start": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:voice": "tsx scripts/test-voice-turn-detector.ts && tsx scripts/test-transcript-merging.ts && tsx scripts/test-voice-conversation-controller.ts",
    "test:updater": "node scripts/test-updater.cjs",
    "test:backend": "uv run --project backend pytest",
    "version:check": "node scripts/check-version.mjs",
    "release:verify": "npm run version:check && npm run lint && npm run test:voice && npm run test:updater && npm run test:relay && npm run test:backend",
    "test:relay": "npm --prefix relay-worker run check",
    "build:backend": "uv run --project backend pyinstaller --noconfirm --clean --onefile --name shree-backend --distpath backend-dist --workpath backend/.build --specpath backend/.build --collect-all google.genai --collect-all keyring --collect-all uvicorn backend/run.py",
    "build:desktop": "npm run build",
    "package:win": "npm run build && npm run build:backend && electron-builder --win nsis"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "builder-util-runtime": "9.7.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.0.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "protobufjs": "7.6.5"
  },
  "build": {
    "appId": "ai.shree.mark12",
    "productName": "Shree",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/branding/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/shree-backend.exe",
        "to": "backend/shree-backend.exe"
      }
    ],
    "directories": {
      "output": "release-1.1.52",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NotQuiteAyush",
        "repo": "Shree-AI",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/shree.ico",
      "artifactName": "Shree-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shree",
      "installerIcon": "build/shree.ico",
      "uninstallerIcon": "build/shree.ico"
    }
  }
}
