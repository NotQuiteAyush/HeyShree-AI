# Gemini credentials are configured only inside SHREE Settings and are stored
# in Windows Credential Manager. Do not place API keys in this file.

# The desktop backend binds to loopback only. Change the port only if needed.
HOST="127.0.0.1"
PORT="8765"
DATA_DIR="%LOCALAPPDATA%\\SHREE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
